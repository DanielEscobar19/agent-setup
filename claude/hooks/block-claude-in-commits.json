{
  "_note": "Workspace hook. Needs scripts/hooks/block-claude-in-commits.js copied to <workspace>/.claude/scripts/.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "if": "Bash(git commit *)", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/scripts/block-claude-in-commits.js\"", "timeout": 10 }
        ]
      }
    ]
  }
}
